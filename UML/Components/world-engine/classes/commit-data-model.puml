@startuml
' bt-view-kind: class
' bt-view-id: world-engine:commit-data-model
title World Engine - Commit Data Model
left to right direction
skinparam shadowing false
skinparam wrapWidth 220
skinparam maxMessageSize 180

' bt-element-id: session
' bt-element-id: proposal
' bt-element-id: commit
' bt-element-id: persistence_result

class "StorySession\nResponsibility: Aggregate live story truth and bindings\nContract: Monotonic revision and bound content\n[[../../../../world-engine/world_engine/story_runtime/manager/session/session_payloads.py source]]" as session {
  session_id
  content_version
  revision
  world_state
}
class "NarrativeProposal\nResponsibility: Carry uncommitted AI result and evidence\nContract: No authoritative mutations\n[[../../../../world-engine/world_engine/story_runtime/commit_models.py source]]" as proposal {
  blocks
  delta
  aspects
  evidence
}
class "CommitDecision\nResponsibility: Explain accepted or rejected mutation\nContract: Validation and policy evidence\n[[../../../../world-engine/world_engine/story_runtime/manager/commit_finalization.py source]]" as commit {
  status
  accepted_delta
  findings
  revision
}
class "PersistOutcome\nResponsibility: Report whether the authoritative session sink accepted or skipped a write\nContract: Versioned persisted, skipped-simulation or no-store result\n[[../../../../world-engine/world_engine/story_runtime/persist_outcome.py source]]" as persistence_result {
  schema_version
  kind
  reason
  revision
}

commit ..> persistence_result : "requests authoritative write\ncontract: one explicit persistence result\n[[../../../../world-engine/world_engine/story_runtime/manager/session/manager_init_and_persistence.py source]]"
persistence_result ..> session : "confirms durable revision\ncontract: in-memory revision advances only after sink success\n[[../../../../world-engine/world_engine/story_runtime/manager/session/manager_init_and_persistence.py source]]"
proposal ..> commit : "is resolved as\ncontract: validation evidence\n[[../../../../world-engine/world_engine/story_runtime/narrative_commit_resolution.py source]]"
session ..> proposal : "bounds evaluation\ncontract: base revision\n[[../../../../world-engine/world_engine/story_runtime/commit_models.py source]]"

legend bottom
Viewpoint: class
Concern: Session truth, uncommitted proposal, commit decision and explicit persistence outcome
Elements expose responsibility, contract and source anchor.
Edges name the interaction or dependency contract.
endlegend
@enduml
