@startuml
' bt-view-kind: component
' bt-view-id: backend:core-components
title Backend — Core Components
left to right direction
skinparam shadowing false
skinparam wrapWidth 220
skinparam maxMessageSize 180

' bt-element-id: auth
' bt-element-id: services
' bt-element-id: game_api
' bt-element-id: game_service
' bt-element-id: world
' bt-element-id: governance
' bt-element-id: content_service
' bt-element-id: models
' bt-element-id: observability

component "Authentication API\nResponsibility: Issue and revoke platform sessions and tokens\nContract: Password/session/refresh-token policy\n[[../../../../backend/app/api/v1/auth_routes.py source]]" as auth
rectangle "Domain Services\nResponsibility: Implement platform and governance use cases\nContract: Transaction-scoped service operations\n[[../../../../backend/app/services/__init__.py source]]" as services
component "Game API\nResponsibility: Create run bindings and proxy live play operations\nContract: No backend-local narrative commit\n[[../../../../backend/app/api/v1/game/player_turn_execution_and_flush.py source]]" as game_api
component "Game Service\nResponsibility: Call world-engine and map service responses\nContract: Internal HTTP and signed ticket\n[[../../../../backend/app/services/game/game_service.py source]]" as game_service
rectangle "World Engine\nResponsibility: Own live story sessions and commits\nContract: Internal story HTTP API plus signed ticket\n[[../../../../world-engine/app/main.py source]]" as world
component "Governance Services\nResponsibility: Validate provider, route, security and runtime settings\nContract: Audit-producing admin mutation boundary\n[[../../../../backend/app/services/governance/governance_runtime_service.py source]]" as governance
component "Content Services\nResponsibility: Compile, review and publish authored content versions\nContract: Immutable version plus active pointer\n[[../../../../backend/app/services/game/game_content_service.py source]]" as content_service
rectangle "Persistence Models\nResponsibility: Represent backend and narrative-governance durable truth\nContract: SQLAlchemy models and Alembic schema\n[[../../../../backend/app/models/__init__.py source]]" as models
rectangle "Observability\nResponsibility: Record platform traces, metrics and diagnostic evidence\nContract: Trace correlation with redaction\n[[../../../../backend/app/observability/__init__.py source]]" as observability

auth ..> services : "authenticates\ncontract: identity and token services\n[[../../../../backend/app/api/v1/auth_routes.py source]]"
content_service ..> models : "persists package lifecycle\ncontract: immutable versions and events\n[[../../../../backend/app/services/game/game_content_service.py source]]"
governance ..> models : "persists settings and audit\ncontract: validated governance transaction\n[[../../../../backend/app/services/governance/governance_runtime_service.py source]]"
services ..> observability : "emits evidence\ncontract: redacted trace correlation\n[[../../../../backend/app/observability/trace.py source]]"
game_api ..> game_service : "delegates live operation\ncontract: proxy-only service seam\n[[../../../../backend/app/api/v1/game/player_turn_execution_and_flush.py source]]"
game_service ..> world : "calls story API\ncontract: ticketed HTTP request\n[[../../../../backend/app/services/game/game_service.py source]]"

legend bottom
Viewpoint: component
Concern: Identity, play proxy, content and governance collaborations
Elements expose responsibility, contract and source anchor.
Edges name the interaction or dependency contract.
endlegend
@enduml
