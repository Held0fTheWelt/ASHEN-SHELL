  NarrativePackage
  RevisionCandidate
  EvaluationRun
  RuntimeHealth
  RuntimeSession
}
class "Alembic Schema\nResponsibility: Version backend persistence\nContract: Forward migration sequence\n[[../../../../backend/migrations/env.py source]]" as migration {
  48 tracked revisions
  backend tables
  governance tables
}
class "Persistence Models\nResponsibility: Represent backend and narrative-governance durable truth\nContract: SQLAlchemy models and Alembic schema\n[[../../../../backend/app/models/__init__.py source]]" as models {

}

migration ..> models : "versions\ncontract: Alembic migration history\n[[../../../../backend/migrations/env.py source]]"
models ..> narrative_models : "contains\ncontract: governance read model ownership\n[[../../../../backend/app/models/world_engine/__init__.py source]]"
