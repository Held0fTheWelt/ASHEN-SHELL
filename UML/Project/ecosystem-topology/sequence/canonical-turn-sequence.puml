@startuml
' bt-view-kind: sequence
' bt-view-id: ecosystem-topology:canonical-turn
title Better Tomorrow - Canonical Turn

skinparam shadowing false
skinparam wrapWidth 220
skinparam maxMessageSize 180

' bt-element-id: player
' bt-element-id: frontend
' bt-element-id: backend
' bt-element-id: world
' bt-element-id: content
' bt-element-id: ai

actor "Player\nResponsibility: Experience and influence a live dramatic scene\nContract: Authenticated semantic interaction\n[[../../../../frontend/templates/session_shell.html source]]" as player
participant "Frontend\nResponsibility: Present player interaction and transient UI state\nContract: Browser shell\n[[../../../../frontend/app/__init__.py source]]" as frontend
participant "Backend\nResponsibility: Own identity, community and control-plane truth\nContract: Flask API\n[[../../../../backend/app/factory_app.py source]]" as backend
participant "World Engine\nResponsibility: Own live sessions and commit story truth\nContract: Story HTTP/WebSocket API\n[[../../../../world-engine/app/main.py source]]" as world
participant "Content Authority\nResponsibility: Own authored experience facts and policy\nContract: Versioned YAML modules\n[[../../../../content/modules/god_of_carnage/module.yaml source]]" as content
participant "AI Stack\nResponsibility: Propose dramatically informed outcomes\nContract: Proposal-only runtime\n[[../../../../ai_stack/langgraph/langgraph_runtime_executor.py source]]" as ai

player -> frontend : "interacts\ncontract: browser session\n[[../../../../frontend/app/routes_play.py source]]"
frontend -> backend : "authenticates and launches\ncontract: HTTP API\n[[../../../../frontend/app/api_client.py source]]"
backend -> world : "delegates live turn\ncontract: signed proxy request\n[[../../../../backend/app/services/game/game_service.py source]]"
content -> world : "binds authored truth\ncontract: content version\n[[../../../../world-engine/app/content/backend_loader.py source]]"
world -> ai : "requests proposal\ncontract: bounded context\n[[../../../../world-engine/app/story_runtime/governed_runtime_adapters.py source]]"
world -> frontend : "streams committed blocks\ncontract: post-commit events\n[[../../../../world-engine/app/api/story_ws.py source]]"

legend bottom
Viewpoint: sequence
Concern: Whole-system player turn across all authority boundaries
Elements expose responsibility, contract and source anchor.
Edges name the interaction or dependency contract.
endlegend
@enduml
