@startuml
' bt-view-kind: state
' bt-view-id: quality-gates:gate-lifecycle
title Quality Gates - Lifecycle
left to right direction
skinparam shadowing false
skinparam wrapWidth 220
skinparam maxMessageSize 180

' bt-element-id: declared
' bt-element-id: selected
' bt-element-id: executed
' bt-element-id: accepted
' bt-element-id: failed

state "Declared\nResponsibility: Register suite and purpose\nContract: Discoverable by central runner\n[[../../../../tests/run_tests.py source]]" as declared
state "Selected\nResponsibility: Include suite for current scope\nContract: Selection reason visible\n[[../../../../scripts/test_changed.py source]]" as selected
state "Executed\nResponsibility: Run all selected tests\nContract: No hidden skip\n[[../../../../tests/run_tests.py source]]" as executed
state "Accepted\nResponsibility: Permit promotion\nContract: All required gates pass\n[[../../../../.github/workflows/quality-gate.yml source]]" as accepted
state "Failed\nResponsibility: Block promotion with evidence\nContract: Actionable finding\n[[../../../../tests/reports/RUNNER_CI_TRUTH_MATRIX.md source]]" as failed

declared --> selected : "profile requires suite\ncontract: selection visible"
executed --> accepted : "all assertions pass\ncontract: required evidence"
executed --> failed : "assertion or discovery fails\ncontract: blocking finding"
[*] --> declared : "suite registered\ncontract: owner and purpose"
selected --> executed : "runner invokes suite\ncontract: command recorded\n[[../../../../tests/run_tests.py source]]"

legend bottom
Viewpoint: state
Concern: Declared and selected suites cannot silently bypass execution
Elements expose responsibility, contract and source anchor.
Edges name the interaction or dependency contract.
endlegend
@enduml
