@startuml
' bt-view-kind: state
' bt-view-id: security-governance:credential-lifecycle
title Security Governance - Credential Lifecycle
left to right direction
skinparam shadowing false
skinparam wrapWidth 220
skinparam maxMessageSize 180

' bt-element-id: absent
' bt-element-id: sealed
' bt-element-id: active
' bt-element-id: rotating
' bt-element-id: revoked

state "Absent\nResponsibility: Represent unconfigured provider credential\nContract: Runtime not ready\n[[../../../../backend/app/services/governance/governance_runtime/10_provider_listing_and_create.py source]]" as absent
state "Sealed\nResponsibility: Store encrypted credential\nContract: Ciphertext only\n[[../../../../backend/app/services/governance/governance_runtime/04_provider_secret_and_model_helpers.py source]]" as sealed
state "Active\nResponsibility: Permit scoped provider use\nContract: Health and policy valid\n[[../../../../backend/app/services/governance/governance_runtime/12_provider_connection_health.py source]]" as active
state "Rotating\nResponsibility: Replace credential without plaintext exposure\nContract: Audited atomic replacement\n[[../../../../backend/app/services/governance/governance_runtime/11_provider_update_and_credentials.py source]]" as rotating
state "Revoked\nResponsibility: Prevent further resolution\nContract: Audit retained\n[[../../../../backend/app/services/governance/governance_runtime/14_model_update_delete_rebind.py source]]" as revoked

absent --> sealed : "credential supplied\ncontract: encrypt before persistence\n[[../../../../backend/app/services/governance/governance_runtime/11_provider_update_and_credentials.py source]]"
active --> revoked : "provider disabled\ncontract: resolution denied\n[[../../../../backend/app/services/governance/governance_runtime/14_model_update_delete_rebind.py source]]"
active --> rotating : "rotation requested\ncontract: old secret remains until replacement valid\n[[../../../../backend/app/services/governance/governance_runtime/11_provider_update_and_credentials.py source]]"
[*] --> absent : "provider created\ncontract: no secret"
rotating --> active : "replacement committed\ncontract: audit and key version advance"
sealed --> active : "health and policy pass\ncontract: provider ready\n[[../../../../backend/app/services/governance/governance_runtime/12_provider_connection_health.py source]]"

legend bottom
Viewpoint: state
Concern: Absent, sealed, active, rotating and revoked provider credentials
Elements expose responsibility, contract and source anchor.
Edges name the interaction or dependency contract.
endlegend
@enduml
