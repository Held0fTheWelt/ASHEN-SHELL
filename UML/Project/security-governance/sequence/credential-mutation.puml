@startuml
' bt-view-kind: sequence
' bt-view-id: security-governance:credential-mutation
title Security Governance - Credential Mutation

skinparam shadowing false
skinparam wrapWidth 220
skinparam maxMessageSize 180

' bt-element-id: operator
' bt-element-id: security
' bt-element-id: frontend
' bt-element-id: routes
' bt-element-id: service
' bt-element-id: credentials
' bt-element-id: audit

actor "Operator\nResponsibility: Manage providers, policies and security settings\nContract: Privileged authenticated action\n[[../../../../administration-tool/app.py source]]" as operator
participant "Security Governance\nResponsibility: Authorize, protect and audit sensitive operations\nContract: Backend-owned policy boundary\n[[../../../../backend/app/services/governance/security_governance_service.py source]]" as security
participant "Frontend Auth\nResponsibility: Maintain browser session and CSRF policy\nContract: No credential authority\n[[../../../../frontend/app/auth.py source]]" as frontend
participant "Security Governance API\nResponsibility: Authenticate and authorize privileged requests\nContract: Role and CSRF guarded endpoints\n[[../../../../backend/app/api/v1/security_governance_routes.py source]]" as routes
participant "Security Governance Service\nResponsibility: Validate policy and credential operations\nContract: Fail-closed domain service\n[[../../../../backend/app/services/governance/security_governance_service.py source]]" as service
participant "Provider Credential Service\nResponsibility: Seal, rotate and resolve provider secrets\nContract: No plaintext persistence or response\n[[../../../../backend/app/services/governance/governance_runtime_service_impl.py source]]" as credentials
participant "Security Audit\nResponsibility: Record privileged action without secret content\nContract: Actor, scope and outcome\n[[../../../../backend/app/services/governance/observability_governance_service.py source]]" as audit

operator -> security : "requests privileged mutation\ncontract: role and CSRF checks"
security -> frontend : "accepts authenticated browser intent\ncontract: frontend proves session and CSRF context only\n[[../../../../frontend/app/auth.py source]]"
frontend -> routes : "submits authenticated intent\ncontract: session, CSRF and role\n[[../../../../frontend/app/auth.py source]]"
routes -> service : "delegates authorized operation\ncontract: validated request\n[[../../../../backend/app/api/v1/security_governance_routes.py source]]"
service -> credentials : "seals or rotates credential\ncontract: plaintext ephemeral only\n[[../../../../backend/app/services/governance/governance_runtime_service_impl.py source]]"
service -> audit : "records outcome\ncontract: redacted security event\n[[../../../../backend/app/services/governance/observability_governance_service.py source]]"

legend bottom
Viewpoint: sequence
Concern: Privileged intent becomes encrypted state and redacted audit
Elements expose responsibility, contract and source anchor.
Edges name the interaction or dependency contract.
endlegend
@enduml
