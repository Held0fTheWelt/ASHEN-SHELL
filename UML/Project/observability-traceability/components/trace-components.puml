@startuml
' bt-view-kind: component
' bt-view-id: observability-traceability:trace-components
title Observability - Components
left to right direction
skinparam shadowing false
skinparam wrapWidth 220
skinparam maxMessageSize 180

' bt-element-id: backend
' bt-element-id: world
' bt-element-id: ai
' bt-element-id: mcp
' bt-element-id: projection

component "Backend Trace Start\nResponsibility: Create or propagate player request identity\nContract: Stable trace and request ids\n[[../../../../backend/app/api/v1/game/player_turn_trace_start.py source]]" as backend
component "World Runtime Trace\nResponsibility: Record authoritative lifecycle spans\nContract: Session and revision correlation\n[[../../../../world-engine/world_engine/observability/trace.py source]]" as world
component "AI Langfuse Evidence\nResponsibility: Record retrieval, planning, generation and validation spans\nContract: Proposal trace under parent turn\n[[../../../../ai_stack/langfuse/langfuse_evidence.py source]]" as ai
component "MCP Trace Adapter\nResponsibility: Record tool execution with redaction\nContract: No secret payloads\n[[../../../../tools/mcp_server/langfuse_tracing.py source]]" as mcp
component "Operator Projection\nResponsibility: Present cross-service trace tree and diagnostics\nContract: Read-only evidence view\n[[../../../../world-engine/world_engine/web/static/ui_traces.js source]]" as projection

mcp ..> projection : "adds tool evidence\ncontract: redacted MCP span\n[[../../../../tools/mcp_server/langfuse_tracing.py source]]"
backend ..> world : "propagates trace context\ncontract: trace and request ids\n[[../../../../backend/app/api/v1/game/trace_identity_and_auth_helpers.py source]]"
world ..> ai : "parents proposal trace\ncontract: turn trace context\n[[../../../../world-engine/world_engine/story_runtime/governed_runtime_adapters.py source]]"
ai ..> world : "returns evidence references\ncontract: proposal span linkage\n[[../../../../ai_stack/langfuse/langfuse_evidence.py source]]"
world ..> projection : "publishes lifecycle evidence\ncontract: redacted trace DTO\n[[../../../../world-engine/world_engine/web/static/ui_traces.js source]]"

legend bottom
Viewpoint: component
Concern: Backend, world, AI, MCP and operator projection span ownership
Elements expose responsibility, contract and source anchor.
Edges name the interaction or dependency contract.
endlegend
@enduml
